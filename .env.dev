# ===========================================
# Variáveis de interpolação do docker-compose para o ambiente de DESENVOLVIMENTO.
# Carregado via `--env-file .env.dev` (ver Makefile / docker-compose.dev.yml).
# ===========================================
# Portas próprias do dev — não colidem com produção (8001 / 3001).
BACKEND_PORT=8002
FRONTEND_PORT=3002
