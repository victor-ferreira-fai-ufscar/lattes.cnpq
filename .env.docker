# ===========================================
# DOCKER COMPOSE - Valores Padrão para Desenvolvimento
# ===========================================
# Este arquivo define variáveis de runtime para os containers.
# Para alterar interpolação do docker-compose (ex.: portas), use variáveis
# de shell ou um arquivo `.env` na raiz do projeto.

# ===========================================
# PLAYWRIGHT - NAVEGADOR
# ===========================================
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true

# ===========================================
# SERVIDOR
# ===========================================
BACKEND_PORT=8001
FRONTEND_PORT=3001

# Origens liberadas no CORS do backend (endereços de acesso ao frontend)
# https://lattes.sup... = acesso via Caddy (HTTPS); os :3001 = acesso HTTP direto legado
BACKEND_CORS_ORIGINS=https://lattes.sup.fai.ufscar.br,http://localhost:3001,http://127.0.0.1:3001,http://200.136.209.229:3001,http://10.10.10.5:3001

# ===========================================
# OLLAMA (opcional para endpoint /summarize)
# ===========================================
# O backend tenta automaticamente, em ordem: os endpoints de OLLAMA_BASE_URLS,
# depois OLLAMA_BASE_URL, e por fim os padrões (host.docker.internal, localhost
# e 127.0.0.1 na porta 11434). Usa o primeiro que responder.
# Como o Ollama desta máquina roda fora de container, localhost/127.0.0.1 e
# host.docker.internal já são cobertos pelos padrões.
# Para apontar para um IP/porta específico, use OLLAMA_BASE_URLS (lista separada
# por vírgula), ex.: OLLAMA_BASE_URLS=http://10.10.10.5:11434,http://localhost:11434
# Backend roda em network_mode: host, então o Ollama do host está em localhost.
OLLAMA_BASE_URLS=http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ===========================================
# ENRIQUECIMENTO EXTERNO (OpenAlex + notícias)
# ===========================================
# Anexa a cada docente a produção acadêmica (OpenAlex) e notícias (Google News
# RSS). Ambas as fontes são públicas e sem chave. Só entra no resultado o que
# atinge confiança alta na identificação — ver core/perfil_externo.py.
# Desligue com false se alguma fonte mudar de formato ou ficar instável.
PERFIL_EXTERNO_ENABLED=true

# E-mail de contato enviado ao OpenAlex ("polite pool": rate limit melhor).
OPENALEX_MAILTO=joao.silva@fai.ufscar.br

# Timeout por chamada HTTP às fontes externas (segundos).
PERFIL_EXTERNO_TIMEOUT=8

# Dado externo muda devagar; 24h evita repetir ~100 chamadas ao reprocessar um lote.
PERFIL_EXTERNO_CACHE_TTL=86400

# Afiliações que confirmam a identidade do docente no score de desambiguação.
PERFIL_EXTERNO_AFILIACOES=UFSCar,Universidade Federal de São Carlos,FAI

# Quantidade máxima de itens trazidos por docente.
PERFIL_EXTERNO_OBRAS_MAX=10
PERFIL_EXTERNO_NOTICIAS_MAX=5

# Chaves e variáveis sensíveis do backend devem ficar em `backend/.env`.
