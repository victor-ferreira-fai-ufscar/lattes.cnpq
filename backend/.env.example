# Lattes Scraper - Configurações de Ambiente
# Copie este arquivo para .env e configure suas chaves

# ===========================================
# NAVEGADOR PLAYWRIGHT
# ===========================================

# Browser: chromium, firefox ou webkit
PLAYWRIGHT_BROWSER=chromium

# Executar sem interface gráfica (false = visualiza o browser)
PLAYWRIGHT_HEADLESS=true

# ===========================================
# SERVIDOR
# ===========================================

# Porta do backend
BACKEND_PORT=8000

# Porta do frontend
FRONTEND_PORT=3000

# Origins permitidas para CORS (separadas por vírgula)
# Em produção, substitua pelo domínio real da aplicação
BACKEND_CORS_ORIGINS=http://localhost:3000

# Dica:
# Rode "uv run playwright install chromium" após instalar dependências

# ===========================================
# SUPABASE STORAGE (OBRIGATÓRIO PARA /scrape)
# ===========================================
# Supabase é self-hosted nesta máquina (ver supabase/README.md), não na nuvem.
# Suba com `make supabase-up`.

# URL PÚBLICA da instância, não localhost: o SDK monta os links de download como
# {SUPABASE_URL}/storage/v1/object/public/..., e esses links abrem no navegador.
SUPABASE_URL=https://lattes-storage.sup.fai.ufscar.br

# Copie de /srv/docker/lattes-supabase/.env (geradas por utils/generate-keys.sh).
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY do /srv/docker/lattes-supabase/.env>
# SUPABASE_ANON_KEY=<ANON_KEY do /srv/docker/lattes-supabase/.env>

# Bucket e pasta onde os PDFs serão salvos.
# Dev usa lattes-cvs-dev (sobrescrito em docker-compose.dev.yml).
SUPABASE_STORAGE_BUCKET=lattes-cvs
SUPABASE_STORAGE_FOLDER=raw

# true: retorna URL pública (bucket público)
# false: retorna URL assinada com expiração
SUPABASE_STORAGE_PUBLIC=true
SUPABASE_SIGNED_URL_EXPIRES_IN=3600

# ===========================================
# GEMINI (para endpoint /summarize)
# ===========================================
# GEMINI_API_KEY=AIza...

# ===========================================
# OPENAI (para endpoint /summarize)
# ===========================================
# OPENAI_API_KEY=sk-...

# ===========================================
# OLLAMA (para endpoint /summarize)
# ===========================================
# Endpoint da API local do Ollama (modo OpenAI-compatible)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Modelo default sugerido quando usar provedor ollama
OLLAMA_MODEL=llama3.1
# Opcional para cenários com autenticação
# OLLAMA_API_KEY=ollama
